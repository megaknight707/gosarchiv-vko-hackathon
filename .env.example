# Шаблон переменных окружения. Скопируйте в .env.local и заполните.
#   copy .env.example .env.local      (PowerShell / cmd)
# Файл .env.local в git НЕ попадает. Реальные ключи — только в .env.local и в настройках Vercel.

# ─── База данных ───
# Локально (Docker, npm run db:up): обе строки одинаковые.
# Supabase: DATABASE_URL — Transaction pooler (порт 6543) + ?pgbouncer=true
#           DIRECT_URL   — Session pooler (порт 5432) или прямое подключение — для миграций
DATABASE_URL="postgresql://gosarchiv:gosarchiv@localhost:5433/gosarchiv"
DIRECT_URL="postgresql://gosarchiv:gosarchiv@localhost:5433/gosarchiv"

# ─── Адрес сайта ───
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Режимы ───
# DEMO_MODE=true  → плашка «не официальный сайт» и noindex на всём сайте
DEMO_MODE="true"
# AI_MODE=online  → Claude API; offline → разбор запроса без ИИ (lib/search/query-parser.ts)
AI_MODE="offline"

# ─── Claude API (только сервер!) ───
ANTHROPIC_API_KEY="sk-ant-..."

# ─── Авторизация админки: длинная случайная строка ───
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-with-random-string"

# ─── Хранилище файлов ───
# local    → public/uploads/ (разработка)
# supabase → Supabase Storage, bucket archive-media (продакшен)
STORAGE_DRIVER="local"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="service-role-key-only-on-server"

# ─── Сид (необязательно) ───
# Если задан — у всех демо-пользователей админки будет этот пароль; иначе случайные
SEED_ADMIN_PASSWORD=""
