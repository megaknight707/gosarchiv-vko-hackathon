{
  "name": "gosarchiv-vko-hackathon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "typecheck": "next typegen && tsc --noEmit",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "seed:reset": "tsx prisma/seed.ts --reset",
    "scans": "tsx scripts/generate-demo-scans.ts",
    "scans:upload": "tsx scripts/upload-demo-scans.ts",
    "prod:migrate": "node --env-file=.env.production.local node_modules/prisma/build/index.js migrate deploy",
    "prod:seed": "tsx --env-file=.env.production.local prisma/seed.ts",
    "prod:seed:reset": "tsx --env-file=.env.production.local prisma/seed.ts --reset",
    "prod:scans:upload": "tsx --env-file=.env.production.local scripts/upload-demo-scans.ts",
    "seed:content": "tsx prisma/seed-content.ts",
    "prod:seed:content": "tsx --env-file=.env.production.local prisma/seed-content.ts",
    "seed:memory": "tsx prisma/seed-memory.ts",
    "prod:seed:memory": "tsx --env-file=.env.production.local prisma/seed-memory.ts",
    "seed:branches": "tsx prisma/seed-branches.ts",
    "prod:seed:branches": "tsx --env-file=.env.production.local prisma/seed-branches.ts",
    "seed:calendar": "tsx prisma/seed-calendar.ts",
    "prod:seed:calendar": "tsx --env-file=.env.production.local prisma/seed-calendar.ts",
    "seed:funds": "tsx prisma/seed-fund-registry.ts",
    "prod:seed:funds": "tsx --env-file=.env.production.local prisma/seed-fund-registry.ts",
    "staff:password": "tsx scripts/set-staff-password.ts",
    "prod:staff:password": "tsx --env-file=.env.production.local scripts/set-staff-password.ts",
    "seed:restricted": "tsx scripts/seed-restricted-scan.ts",
    "prod:seed:restricted": "tsx --env-file=.env.production.local scripts/seed-restricted-scan.ts",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@supabase/supabase-js": "^2.119.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "jose": "^6.2.17",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.70.0",
    "next": "16.4.6",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "^5.0.0",
    "react-zoom-pan-pinch": "^4.2.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sharp": "^0.35.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "^7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
