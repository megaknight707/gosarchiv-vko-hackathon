{
  "name": "gosarchiv-vko-video",
  "private": true,
  "description": "Видеопрезентация проекта: запись экрана (Playwright), озвучка (edge-tts), монтаж (HTML-сцена + ffmpeg)",
  "type": "module",
  "scripts": {
    "tts": "python scripts/synthesize-voice.py",
    "timeline": "node scripts/build-timeline.mjs",
    "record": "node scripts/record-screens.mjs",
    "mix": "node scripts/mix-audio.mjs",
    "render:preview": "node scripts/render-video.mjs --preview",
    "render:final": "node scripts/render-video.mjs --final"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/pt-sans": "^5.3.0",
    "@fontsource/pt-serif": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "qrcode": "^1.5.4"
  }
}
